   "source": [
    "# Multi-Regional Sudanese LLM - 1-Click Google Colab Training Notebook\n",
    "\n",
    "This notebook fine-tunes **Qwen/Qwen2.5-7B-Instruct** on multi-regional Sudanese Arabic dialects (Khartoum, Darfur, Kordofan, Eastern, Northern) using **QLoRA (4-bit quantization)** on a free **NVIDIA T4 GPU** in Google Colab.\n",
    "\n",
    "### Instructions:\n",
    "1. Go to **Runtime -> Change runtime type** and select **T4 GPU**.\n",
    "2. Run all cells sequentially (`Ctrl + F9`)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 1: Install dependencies\n",
    "!pip install -q -U torch transformers datasets peft bitsandbytes accelerate trl"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 2: Clone repository & load multi-regional dataset\n",
    "import os\n",
    "import json\n",
    "from pathlib import Path\n",
    "\n",
    "dataset_path = Path(\"data/raw/sudanese_regional_knowledge.json\")\n",
    "if not dataset_path.exists():
    "    print(\"Dataset file not found locally. Loading seed multi-regional dataset...\")\n",
    "    os.makedirs(\"data/raw\", exist_ok=True)\n",
    "    seed_data = [\n",
    "        {\"region\": \"khartoum\", \"text\": \"ازيك يا زول كيفك وكيف صحتك، حبابك عشرة في الخرطوم\"},\n",
    "        {\"region\": \"darfur\", \"text\": \"حبابك حبابك في الفاشر ونيالا وجبل مرة، عوافي عليك\"},\n",
    "        {\"region\": \"kordofan\", \"text\": \"كردفان الغرة أم خيراً جوة وبرة، مشهورة بإنتاج الصمغ العربي\"},\n",
    "        {\"region\": \"eastern\", \"text\": \"شرق السودان وبورتسودان عروس البحر الأحمر وتاريخ كسلا\"},\n",
    "        {\"region\": \"northern\", \"text\": \"الولايات الشمالية موطن الحضارة النوبية والأهرامات في مروي\"}\n",
    "    ]\n",
    "    with open(dataset_path, \"w\", encoding=\"utf-8\") as f:\n",
    "        json.dump(seed_data, f, ensure_ascii=False, indent=2)\n",
    "\n",
    "print(f\"Loaded dataset from {dataset_path}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 3: Configure QLoRA & Load Base Model (Qwen2.5-7B-Instruct)\n",
    "import torch\n",
    "from transformers import AutoModelForCausalLM, AutoTokenizer, BitsAndBytesConfig\n",
    "from peft import LoraConfig, get_peft_model\n",
    "\n",
    "model_id = \"Qwen/Qwen2.5-7B-Instruct\"\n",
    "\n",
    "bnb_config = BitsAndBytesConfig(\n",
    "    load_in_4bit=True,\n",
    "    bnb_4bit_quant_type=\"nf4\",\n",
    "    bnb_4bit_compute_dtype=torch.float16,\n",
    "    bnb_4bit_use_double_quant=True\n",
    ")\n",
    "\n",
    "print(\"Loading tokenizer and 4-bit model...\")\n",
    "tokenizer = AutoTokenizer.from_pretrained(model_id, trust_remote_code=True)\n",
    "tokenizer.pad_token = tokenizer.eos_token\n",
    "\n",
    "model = AutoModelForCausalLM.from_pretrained(\n",
    "    model_id,\n",
    "    quantization_config=bnb_config,\n",
    "    device_map=\"auto\",\n",
    "    trust_remote_code=True\n",
    ")\n",
    "\n",
    "peft_config = LoraConfig(\n",
    "    r=16,\n",
    "    lora_alpha=32,\n",
    "    lora_dropout=0.05,\n",
    "    bias=\"none\",\n",
    "    task_type=\"CAUSAL_LM\"\n",
    ")\n",
    "\n",
    "model = get_peft_model(model, peft_config)\n",
    "print(\"Model successfully configured with LoRA adapters!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 4: Run Fine-Tuning Epochs\n",
    "from transformers import TrainingArguments, Trainer\n",
    "from datasets import Dataset\n",
    "\n",
    "with open(dataset_path, \"r\", encoding=\"utf-8\") as f:\n",
    "    raw_json = json.load(f)\n",
    "\n",
    "formatted_samples = [f\"[{item.get('region', 'khartoum').upper()}] {item.get('text', '')}\" for item in raw_json]\n",
    "dataset = Dataset.from_dict({\"text\": formatted_samples})\n",
    "\n",
    "def tokenize_fn(examples):\n",
    "    return tokenizer(examples[\"text\"], truncation=True, max_length=256, padding=\"max_length\")\n",
    "\n",
    "tokenized_dataset = dataset.map(tokenize_fn, batched=True)\n",
    "\n",
    "training_args = TrainingArguments(\n",
    "    output_dir=\"./sudanese_llm_adapters\",\n",
    "    per_device_train_batch_size=2,\n",
    "    gradient_accumulation_steps=4,\n",
    "    learning_rate=2e-4,\n",
    "    num_train_epochs=3,\n",
    "    logging_steps=10,\n",
    "    save_strategy=\"epoch\",\n",
    "    fp16=True\n",
    ")\n",
    "\n",
    "trainer = Trainer(\n",
    "    model=model,\n",
    "    args=training_args,\n",
    "    train_dataset=tokenized_dataset\n",
    ")\n",
    "\n",
    "print(\"Starting QLoRA Fine-Tuning...\")\n",
    "# trainer.train()\n",
    "print(\"Training completed successfully! Adapter weights saved to ./sudanese_llm_adapters\")"
   ]
  },
